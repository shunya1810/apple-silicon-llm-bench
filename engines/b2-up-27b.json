{
 "id": "b2-up-27b",
 "label": "MTPLX upstream v2.12.2, Qwen3.8-27B",
 "port": 18121,
 "model_id": "mtplx",
 "tokenizer_dir": "${B2_MODEL_27B}",
 "model_artifact": "mlx-community/Qwen3.8-27B-4bit body (4-bit g64, unchanged codes, floats cast to fp16) + native Qwen3.8 MTP head (INT4 g64, from Youssofal/Qwen3.8-27B-MTPLX-Optimized-Speed-FP16)",
 "mtp_impl": "MTPLX native MTP, the engine's default depth for the pack",
 "stats": "mtplx-metrics",
 "health_path": "/health",
 "start_timeout_s": 1200,
 "env": {
  "PYTHONPATH": "${B2_UPSTREAM}"
 },
 "cmd": [
  "${MTPLX_PYTHON}",
  "-m",
  "mtplx.cli",
  "serve",
  "--model",
  "${B2_MODEL_27B}",
  "--profile",
  "turbo",
  "--host",
  "127.0.0.1",
  "--port",
  "18121",
  "--no-auth",
  "--yes",
  "--warmup-tokens",
  "0",
  "--ssd-session-cache",
  "off",
  "--context-window",
  "262144",
  "--max-tokens",
  "4096"
 ],
 "default_kv": "q8",
 "kv_variants": {
  "q8": {
   "kv_impl": "MTPLX paged KV, affine q8",
   "cmd_extra": [
    "--paged-kv-quantization",
    "q8"
   ]
  }
 },
 "version_cmds": {
  "commit": "git -C ${B2_UPSTREAM} rev-parse HEAD"
 },
 "allow_missing_native_extensions": true
}
