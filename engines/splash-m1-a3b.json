 "request_extra": {
  "reasoning_effort": "none"
 },
 "cmd": [
  "${SPLASH_M1_130}",
  "serve",
  "--model",
  "incoai/Qwen3.6-35B-A3B-Splash",
  "--host",
  "127.0.0.1",
  "--port",
  "18107",
  "--served-model-name",
  "splash",
  "--default-reasoning-effort",
  "none",
  "--max-context",
  "256K",
  "--no-webui"
 ],
 "default_kv": "q8",
 "kv_variants": {
  "q8": {
   "kv_impl": "Splash INT8 target KV (default)",
   "cmd_extra": [
    "--kv-format",
    "int8"
   ]
  },
  "fp16": {
   "kv_impl": "Splash BF16 target KV",
   "cmd_extra": [
    "--kv-format",
    "bf16"
   ]
  }
 },
 "version_cmds": {
  "version": "${SPLASH_M1_130} --version"
 }
}