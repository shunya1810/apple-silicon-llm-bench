{
 "id": "splash-m1-a3b",
 "label": "Splash 1.3.0-m1.1 (paperniuk M1/M2 build), Qwen3.6-35B-A3B",
 "port": 18107,
 "model_id": "splash",
 "tokenizer_dir": "${MTPLX_MODEL}",
 "model_artifact": "incoai/Qwen3.6-35B-A3B-Splash: Splash package of Qwen3.6-35B-A3B (MoE) with its DFlash2 draft",
