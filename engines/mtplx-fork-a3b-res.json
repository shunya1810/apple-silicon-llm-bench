{
 "id": "mtplx-fork-a3b-res",
 "label": "MTPLX M1 fork moe-s3 (3713c89d plus the fix of 38f56cb2; the same code as v2.12.2-m1.5), Qwen3.6-35B-A3B",
 "port": 18106,
 "model_id": "mtplx",
 "tokenizer_dir": "${MTPLX_MODEL_A3B}",
 "model_artifact": "Youssofal/Qwen3.6-35B-A3B-MTPLX-Optimized-Speed-FP16 (revision f5e001d): MoE, 256 experts, 8 active, 4-bit g64 body, 8-bit gates, native MTP head",
 "mtp_impl": "MTPLX native MTP, depth 1, M1 A3B lane (fp16 whole-MoE, capture_commit, device-resident rounds)",
 "stats": "mtplx-metrics",
 "health_path": "/health",
 "start_timeout_s": 900,
 "env": {
  "PYTHONPATH": "${ROOT}/work/worktrees/mtplx-moe-s3-3713c89d"
 },
 "cmd": [
  "${MTPLX_PYTHON}",
  "-m",
  "mtplx.cli",
  "serve",
  "--model",
  "${MTPLX_MODEL_A3B}",
  "--profile",
  "turbo",
  "--depth",
  "1",
  "--host",
  "127.0.0.1",
  "--port",
  "18106",
  "--no-auth",
  "--yes",
  "--warmup-tokens",
  "0",
  "--ssd-session-cache",
  "off",
  "--context-window",
  "262144",
  "--max-tokens",
  "4096"
 ],
 "default_kv": "q8",
 "kv_variants": {
  "q8": {
   "kv_impl": "MTPLX paged KV, affine q8",
   "cmd_extra": [
    "--paged-kv-quantization",
    "q8"
   ]
  },
  "fp16": {
   "kv_impl": "MTPLX paged KV, unquantized",
   "cmd_extra": [
    "--paged-kv-quantization",
    "off"
   ]
  }
 },
 "version_cmds": {
  "commit": "git -C ${ROOT}/work/worktrees/mtplx-v2.12.2-m1.2 rev-parse HEAD"
 }
}